# API Gateway Endpoint (Local: http://localhost:8080/api/v1, Production: Cloud Run URL)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional: Google AI Studio Gemini API key (if configuring direct client-side Gemini fallback)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
