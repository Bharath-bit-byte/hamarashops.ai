# LinkedIn OIDC Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/v1/auth/linkedin/callback
LINKEDIN_ISSUER=https://www.linkedin.com/oauth

# JWT Configuration
JWT_SECRET=your_jwt_secret_min_256_bits_base64_or_random_characters
JWT_EXPIRATION_MS=86400000

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hamarashops_auth?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Frontend URL
FRONTEND_URL=http://localhost:5173
